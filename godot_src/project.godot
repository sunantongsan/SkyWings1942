; GALAXY 1942 - Godot Edition
config_version=5

[application]
config/name="GALAXY 1942"
config/icon="res://assets/branding/launcher.png"
boot_splash/image="res://assets/branding/startup.png"
boot_splash/show_image=true
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.02, 0.06, 0.10, 1)
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0
window/stretch/aspect="expand"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048

[input_devices]
pointing/emulate_mouse_from_touch=true

[editor_plugins]
enabled=PackedStringArray("res://addons/galaxy_ads/plugin.cfg")
